{
  "openapi": "3.0.0",
  "paths": {
    "/": {
      "get": {
        "description": "Returns the current status of the Daily Meal API for health checks and frontend availability checks.",
        "operationId": "AppController_getStatus",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Returns the API status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiStatusDto"
                },
                "example": {
                  "name": "daily-meal-api",
                  "status": "ok"
                }
              }
            }
          }
        },
        "summary": "Get API status",
        "tags": [
          "status"
        ]
      }
    },
    "/users": {
      "post": {
        "description": "Creates a user account from personal details and matching password fields. The password is never returned in the response.",
        "operationId": "UsersController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUserRequestDto"
              },
              "examples": {
                "registration": {
                  "summary": "Valid registration payload",
                  "value": {
                    "lastname": "Doe",
                    "firstname": "Jane",
                    "email": "jane.doe@example.com",
                    "password": "Str0ngPassword!",
                    "passwordConfirmation": "Str0ngPassword!"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Creates a user account.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicUserDto"
                },
                "example": {
                  "id": "3f6f9824-f4da-4a77-bb6a-5bf1fd9be7d2",
                  "lastname": "Doe",
                  "firstname": "Jane",
                  "email": "jane.doe@example.com",
                  "provider": null,
                  "emailVerified": false,
                  "createdAt": "2026-07-13T10:15:30.000Z",
                  "lastLogin": null
                }
              }
            }
          },
          "400": {
            "description": "The registration payload is invalid or passwordConfirmation does not match password.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                },
                "examples": {
                  "validation": {
                    "summary": "Validation failed",
                    "value": {
                      "statusCode": 400,
                      "message": [
                        "email must be an email"
                      ],
                      "error": "Bad Request"
                    }
                  },
                  "passwordConfirmation": {
                    "summary": "Password confirmation mismatch",
                    "value": {
                      "statusCode": 400,
                      "message": "passwordConfirmation must match password",
                      "error": "Bad Request"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "A user with this email already exists.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                },
                "example": {
                  "statusCode": 409,
                  "message": "A user with this email already exists",
                  "error": "Conflict"
                }
              }
            }
          }
        },
        "summary": "Register a user",
        "tags": [
          "users"
        ]
      }
    },
    "/auth/login": {
      "post": {
        "description": "Authenticates a user with email and password, then returns a stateless JWT access token valid for 24 hours.",
        "operationId": "AuthController_login",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequestDto"
              },
              "examples": {
                "login": {
                  "summary": "Valid login payload",
                  "value": {
                    "email": "jane.doe@example.com",
                    "password": "Str0ngPassword!"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Returns a JWT access token valid for 24 hours.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponseDto"
                },
                "example": {
                  "accessToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
                  "tokenType": "Bearer",
                  "expiresIn": 86400
                }
              }
            }
          },
          "400": {
            "description": "The login payload is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                },
                "example": {
                  "statusCode": 400,
                  "message": [
                    "email must be an email"
                  ],
                  "error": "Bad Request"
                }
              }
            }
          },
          "401": {
            "description": "The email or password is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                },
                "example": {
                  "statusCode": 401,
                  "message": "Invalid email or password",
                  "error": "Unauthorized"
                }
              }
            }
          }
        },
        "summary": "Authenticate a user",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/google": {
      "post": {
        "description": "Verifies a Google ID token for the configured OAuth client, creates the user account when it does not exist, then returns a stateless JWT access token valid for 24 hours.",
        "operationId": "AuthController_loginWithGoogle",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GoogleLoginRequestDto"
              },
              "examples": {
                "googleLogin": {
                  "summary": "Valid Google login payload",
                  "value": {
                    "idToken": "eyJhbGciOiJSUzI1NiIsImtpZCI6Ij..."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Returns a JWT access token valid for 24 hours.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponseDto"
                },
                "example": {
                  "accessToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
                  "tokenType": "Bearer",
                  "expiresIn": 86400
                }
              }
            }
          },
          "400": {
            "description": "The Google login payload is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                },
                "example": {
                  "statusCode": 400,
                  "message": [
                    "idToken must be longer than or equal to 20 characters"
                  ],
                  "error": "Bad Request"
                }
              }
            }
          },
          "401": {
            "description": "The Google ID token is invalid or the email is unverified.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                },
                "example": {
                  "statusCode": 401,
                  "message": "Invalid Google ID token",
                  "error": "Unauthorized"
                }
              }
            }
          }
        },
        "summary": "Authenticate a user with Google",
        "tags": [
          "auth"
        ]
      }
    },
    "/groups": {
      "post": {
        "description": "Creates a group for the authenticated user. The creator and creation date are assigned by the server, and the creator is added as an active admin member.",
        "operationId": "GroupsController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateGroupRequestDto"
              },
              "examples": {
                "creation": {
                  "summary": "Valid group creation payload",
                  "value": {
                    "name": "Family dinners"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Creates a group for the authenticated user.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GroupResponseDto"
                },
                "example": {
                  "id": "a590d72e-4a13-4a68-8e73-1f8c2c905f53",
                  "name": "Family dinners",
                  "createdBy": "3f6f9824-f4da-4a77-bb6a-5bf1fd9be7d2",
                  "createdAt": "2026-07-20T10:15:30.000Z"
                }
              }
            }
          },
          "400": {
            "description": "The group creation payload is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                },
                "example": {
                  "statusCode": 400,
                  "message": [
                    "name should not be empty"
                  ],
                  "error": "Bad Request"
                }
              }
            }
          },
          "401": {
            "description": "The request is missing a valid Bearer access token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                },
                "examples": {
                  "missingToken": {
                    "summary": "Missing token",
                    "value": {
                      "statusCode": 401,
                      "message": "Authentication required",
                      "error": "Unauthorized"
                    }
                  },
                  "invalidToken": {
                    "summary": "Invalid token",
                    "value": {
                      "statusCode": 401,
                      "message": "Invalid access token",
                      "error": "Unauthorized"
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Create a group",
        "tags": [
          "groups"
        ]
      }
    },
    "/me/groups": {
      "get": {
        "description": "Lists the active groups the authenticated user belongs to, including groups they created, with the active member count and the user role in each group.",
        "operationId": "MeController_listGroups",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Returns the authenticated user groups.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MeGroupResponseDto"
                  }
                },
                "example": [
                  {
                    "id": "a590d72e-4a13-4a68-8e73-1f8c2c905f53",
                    "name": "Family dinners",
                    "createdBy": "3f6f9824-f4da-4a77-bb6a-5bf1fd9be7d2",
                    "createdAt": "2026-07-20T10:15:30.000Z",
                    "membersCount": 2,
                    "role": "admin"
                  }
                ]
              }
            }
          },
          "401": {
            "description": "The request is missing a valid Bearer access token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                },
                "examples": {
                  "missingToken": {
                    "summary": "Missing token",
                    "value": {
                      "statusCode": 401,
                      "message": "Authentication required",
                      "error": "Unauthorized"
                    }
                  },
                  "invalidToken": {
                    "summary": "Invalid token",
                    "value": {
                      "statusCode": 401,
                      "message": "Invalid access token",
                      "error": "Unauthorized"
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "List my groups",
        "tags": [
          "me"
        ]
      }
    }
  },
  "info": {
    "title": "Daily Meal API",
    "description": "Interface contract for Daily Meal frontend clients.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "ApiStatusDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "daily-meal-api"
          },
          "status": {
            "type": "string",
            "example": "ok"
          }
        },
        "required": [
          "name",
          "status"
        ]
      },
      "CreateUserRequestDto": {
        "type": "object",
        "properties": {
          "lastname": {
            "type": "string",
            "description": "User last name.",
            "minLength": 2,
            "example": "Doe"
          },
          "firstname": {
            "type": "string",
            "description": "User first name.",
            "minLength": 2,
            "example": "Jane"
          },
          "email": {
            "type": "string",
            "description": "User email address.",
            "minLength": 6,
            "example": "jane.doe@example.com"
          },
          "password": {
            "type": "string",
            "description": "User password.",
            "minLength": 8,
            "example": "Str0ngPassword!"
          },
          "passwordConfirmation": {
            "type": "string",
            "description": "Password confirmation. It must match the password field.",
            "minLength": 8,
            "example": "Str0ngPassword!"
          }
        },
        "required": [
          "lastname",
          "firstname",
          "email",
          "password",
          "passwordConfirmation"
        ]
      },
      "PublicUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique user identifier.",
            "example": "3f6f9824-f4da-4a77-bb6a-5bf1fd9be7d2"
          },
          "lastname": {
            "type": "string",
            "example": "Doe"
          },
          "firstname": {
            "type": "string",
            "example": "Jane"
          },
          "email": {
            "type": "string",
            "example": "jane.doe@example.com"
          },
          "provider": {
            "type": "object",
            "description": "External identity provider, null for local accounts.",
            "example": null,
            "nullable": true
          },
          "emailVerified": {
            "type": "boolean",
            "description": "Whether the user email address is verified.",
            "example": false
          },
          "createdAt": {
            "format": "date-time",
            "type": "string",
            "description": "Account creation date and time.",
            "example": "2026-07-13T10:15:30.000Z"
          },
          "lastLogin": {
            "type": "object",
            "description": "Last login date and time, null when the user never logged in.",
            "format": "date-time",
            "nullable": true,
            "example": null
          }
        },
        "required": [
          "id",
          "lastname",
          "firstname",
          "email",
          "provider",
          "emailVerified",
          "createdAt",
          "lastLogin"
        ]
      },
      "ErrorResponseDto": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "description": "HTTP status code.",
            "example": 400
          },
          "message": {
            "description": "Human-readable error details.",
            "oneOf": [
              {
                "type": "string",
                "example": "passwordConfirmation must match password"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "example": [
                  "email must be an email"
                ]
              }
            ]
          },
          "error": {
            "type": "string",
            "description": "HTTP error reason.",
            "example": "Bad Request"
          }
        },
        "required": [
          "statusCode",
          "message",
          "error"
        ]
      },
      "LoginRequestDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "User email address.",
            "example": "jane.doe@example.com"
          },
          "password": {
            "type": "string",
            "description": "User password.",
            "minLength": 8,
            "example": "Str0ngPassword!"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "LoginResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "JWT access token.",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          },
          "tokenType": {
            "type": "string",
            "description": "Token type to use in the Authorization header.",
            "example": "Bearer"
          },
          "expiresIn": {
            "type": "number",
            "description": "Token lifetime in seconds.",
            "example": 86400
          }
        },
        "required": [
          "accessToken",
          "tokenType",
          "expiresIn"
        ]
      },
      "GoogleLoginRequestDto": {
        "type": "object",
        "properties": {
          "idToken": {
            "type": "string",
            "description": "Google ID token returned by Google Sign-In.",
            "example": "eyJhbGciOiJSUzI1NiIsImtpZCI6Ij..."
          }
        },
        "required": [
          "idToken"
        ]
      },
      "CreateGroupRequestDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Group name.",
            "maxLength": 120,
            "example": "Family dinners"
          }
        },
        "required": [
          "name"
        ]
      },
      "GroupResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique group identifier.",
            "example": "a590d72e-4a13-4a68-8e73-1f8c2c905f53"
          },
          "name": {
            "type": "string",
            "description": "Group name.",
            "example": "Family dinners"
          },
          "createdBy": {
            "type": "string",
            "description": "Identifier of the user who created the group.",
            "example": "3f6f9824-f4da-4a77-bb6a-5bf1fd9be7d2"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string",
            "description": "Group creation date and time.",
            "example": "2026-07-20T10:15:30.000Z"
          }
        },
        "required": [
          "id",
          "name",
          "createdBy",
          "createdAt"
        ]
      },
      "MeGroupResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique group identifier.",
            "example": "a590d72e-4a13-4a68-8e73-1f8c2c905f53"
          },
          "name": {
            "type": "string",
            "description": "Group name.",
            "example": "Family dinners"
          },
          "createdBy": {
            "type": "string",
            "description": "Identifier of the user who created the group.",
            "example": "3f6f9824-f4da-4a77-bb6a-5bf1fd9be7d2"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string",
            "description": "Group creation date and time.",
            "example": "2026-07-20T10:15:30.000Z"
          },
          "membersCount": {
            "type": "number",
            "description": "Number of active members in the group.",
            "example": 2,
            "minimum": 1
          },
          "role": {
            "type": "string",
            "description": "Role of the authenticated user in the group.",
            "enum": [
              "admin",
              "member"
            ],
            "example": "admin"
          }
        },
        "required": [
          "id",
          "name",
          "createdBy",
          "createdAt",
          "membersCount",
          "role"
        ]
      }
    }
  }
}
